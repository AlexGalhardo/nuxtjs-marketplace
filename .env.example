# Copy to .env and fill in. Documentation: docs/environment-variables.md
# NUXT_* variables override runtimeConfig keys at runtime.

# App
# Abort startup when production secrets are missing (keep true outside tests)
NUXT_STRICT_ENV=true
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (test mode keys in development) - required in production
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Platform fee in basis points (1000 = 10%)
NUXT_PLATFORM_FEE_BPS=1000

# Email (Resend). Without an API key, emails are logged instead of sent.
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
NUXT_CONTACT_EMAIL=
