# Copy to .env and fill in. Documentation: docs/environment-variables.md
# NUXT_* variables override runtimeConfig keys at runtime.

# App
# Abort startup when production secrets are missing (keep true outside tests)
NUXT_STRICT_ENV=true
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth (nuxt-auth-utils). >= 32 chars; seals the session cookie. In `nuxt dev` a random one is
# generated and written here automatically if left empty.
NUXT_SESSION_PASSWORD=

# Database (NuxtHub DB + Drizzle). Dialect is fixed at build time (docs/database.md).
# sqlite (default): zero setup, local file at .data/db/sqlite.db
# postgresql: requires DATABASE_URL
NUXT_HUB_DB_DIALECT=sqlite
DATABASE_URL=

# Blob storage (NuxtHub Blob). Empty = local filesystem driver (.data/blob).
# Set all four to use the S3 driver (MinIO in docker-compose, or any S3-compatible provider).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# Stripe (test mode keys in development) - required in production
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Platform fee in basis points (1000 = 10%)
NUXT_PLATFORM_FEE_BPS=1000

# Email (Resend). Without an API key, emails are logged instead of sent.
NUXT_RESEND_API_KEY=
NUXT_EMAIL_FROM=
NUXT_CONTACT_EMAIL=
